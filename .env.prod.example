# Copy to .env on the VPS and fill the values
# DO NOT COMMIT THE REAL .env

# Public URL of the app (used for CORS, NextAuth, OAuth callback)
# IP only example: http://1.2.3.4
# Domain example:  https://travelocount.example.com
PUBLIC_URL=http://CHANGE-ME

# Postgres
POSTGRES_USER=travelocount
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password
POSTGRES_DB=travelocount

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE-ME-64-hex
JWT_REFRESH_SECRET=CHANGE-ME-64-hex

# NextAuth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=CHANGE-ME-base64

# Google OAuth (will not work on raw IP, you need a domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailer (leave empty to log to console only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TraveloCount <no-reply@example.com>
