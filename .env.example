# Postgres
DATABASE_URL="postgresql://travelocount:travelocount@localhost:5432/travelocount?schema=public"

# Nest API
API_PORT=3001
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
