generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripRole {
  ADMIN
  MEMBER
}

enum TripAmbiance {
  CITY_BREAK
  MOUNTAIN
  BEACH
  ROAD_TRIP
}

enum ExpenseCategory {
  TRANSPORT
  LODGING
  RESTAURANT
  ACTIVITY
  OTHER
}

enum SplitMethod {
  EQUAL
  SHARES
  EXACT
}

enum ItineraryType {
  TRANSPORT
  LODGING
  ACTIVITY
  MEAL
}

enum ActivityType {
  TRIP_CREATED
  MEMBER_JOINED
  EXPENSE_ADDED
  EXPENSE_SETTLED
  SETTLEMENT_SENT
  SETTLEMENT_CONFIRMED
  ITINERARY_ADDED
  DOCUMENT_UPLOADED
  MESSAGE_POSTED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  avatarUrl      String?
  googleId       String?        @unique
  activityFilter ActivityType[] @default([TRIP_CREATED, MEMBER_JOINED, EXPENSE_ADDED, EXPENSE_SETTLED, ITINERARY_ADDED, DOCUMENT_UPLOADED, MESSAGE_POSTED])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships      TripMember[]
  expensesPaid     Expense[]        @relation("ExpensePayer")
  expenseShares    ExpenseShare[]
  uploads          Document[]
  messages         Message[]
  activityEvents   ActivityEvent[]
  invitesCreated   Invite[]         @relation("InviteCreator")
  settlementsSent  Settlement[]     @relation("SettlementFrom")
  settlementsRecv  Settlement[]     @relation("SettlementTo")
  tripsCreated     Trip[]           @relation("TripCreator")
}

model Trip {
  id                  String        @id @default(cuid())
  title               String
  destination         String?
  startDate           DateTime?
  endDate             DateTime?
  ambiance            TripAmbiance?
  currency            String        @default("EUR")
  budget              Decimal?      @db.Decimal(12, 2)
  defaultSplitMethod  SplitMethod   @default(EQUAL)
  coverPath           String?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  createdBy User? @relation("TripCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members        TripMember[]
  expenses       Expense[]
  itineraryItems ItineraryItem[]
  documents      Document[]
  messages       Message[]
  activityEvents ActivityEvent[]
  invites        Invite[]
  settlements    Settlement[]
}

model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

model Expense {
  id                    String          @id @default(cuid())
  tripId                String
  payerId               String
  label                 String
  category              ExpenseCategory @default(OTHER)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("EUR")
  amountOriginal        Decimal?        @db.Decimal(12, 2)
  currencyOriginal      String?
  exchangeRate          Decimal?        @db.Decimal(18, 8)
  date                  DateTime
  splitMethod           SplitMethod     @default(EQUAL)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer     User           @relation("ExpensePayer", fields: [payerId], references: [id])
  shares    ExpenseShare[]
  documents Document[]

  @@index([tripId, date])
}

model ExpenseShare {
  id        String  @id @default(cuid())
  expenseId String
  userId    String
  amount    Decimal @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model ItineraryItem {
  id      String        @id @default(cuid())
  tripId  String
  day     Int
  time    String?
  type    ItineraryType
  title   String
  details String?
  address String?
  lat     Float?
  lng     Float?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, day])
}

model Document {
  id              String   @id @default(cuid())
  tripId          String
  uploaderId      String
  filename        String
  storedPath      String
  mimeType        String
  sizeBytes       Int
  linkedExpenseId String?
  createdAt       DateTime @default(now())

  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploader       User     @relation(fields: [uploaderId], references: [id])
  linkedExpense  Expense? @relation(fields: [linkedExpenseId], references: [id], onDelete: SetNull)

  @@index([tripId])
}

model Message {
  id        String   @id @default(cuid())
  tripId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([tripId, createdAt])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  tripId    String
  userId    String
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([tripId, createdAt])
}

model Invite {
  id        String   @id @default(cuid())
  tripId    String
  createdBy String
  token     String   @unique
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator User @relation("InviteCreator", fields: [createdBy], references: [id])

  @@index([tripId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())

  @@unique([base, quote])
}

model Settlement {
  id            String           @id @default(cuid())
  tripId        String
  fromUserId    String
  toUserId      String
  amount        Decimal          @db.Decimal(12, 2)
  currency      String
  status        SettlementStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  rejectedAt    DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  from User @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to   User @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([tripId, status])
}
